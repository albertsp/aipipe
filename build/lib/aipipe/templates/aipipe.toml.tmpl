# Configuracion de aipipe para ESTE proyecto. Lo no indicado aqui se hereda de ~/.config/aipipe/config.toml y de los defaults.

[linear]
team = "{{team}}"                 # clave del equipo en Linear (p. ej. ENG)
trigger_label = "ai-ready"        # solo se procesan tickets con esta etiqueta...
trigger_states = ["Todo"]         # ...y en estos estados
state_in_progress = "In Progress"
state_in_review = "In Review"
failed_label = "ai-failed"
max_per_batch = 5
# Seguridad: por defecto solo se ejecutan issues creadas por el dueño de la API key.
# allowed_creators = ["tu@email.com"]   # sustituye al dueño de la clave (emails o ids de usuario de Linear)
# allow_any_creator = false             # true desactiva el filtro: NO recomendado

# [checkpoints]
# after_plan = "label"     # label: solo tickets con la etiqueta ai:approve | always: todos | never: ninguno
# max_plan_revisions = 2   # veces que puedes responder "cambios: ..." antes de aprobar o rechazar

# [runner]
# max_concurrent = 1      # ejecuciones simultaneas en toda la maquina (nunca 2 en el mismo repo)
# cancel_check_s = 20     # cada cuantos segundos se mira si sacaste la issue de In Progress (= parar)

[project]
base_branch = "{{base_branch}}"
test_command = "{{test_command}}"   # vacio = no se ejecutan tests (no recomendado)
push = true
pr = true                           # requiere GitHub CLI (gh) autenticado
max_attempts = 3
use_review = true

# Descomenta para sobrescribir modelos solo en este proyecto (luego: aipipe install-agents --project --force).
# [models]
# standard = "opencode-go/minimax-m3"

[budget]
soft_stop = 0.85       # pausa la cola al 85% de cualquier ventana de Go (5h / semana / mes)
standard_stop = 0.70
heavy_stop = 0.50
